# ==============================================================================
# SkillGraph ATS — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' inside the 'skillgraph-ats' directory and add your keys:
# cp .env.example skillgraph-ats/.env
# ==============================================================================

# Groq Cloud LPU API Key (Required for structured resume extraction & GraphRAG chat)
# Obtain your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM Cloud API Key (Required for 2048-dim cloud GPU embeddings)
# Obtain your key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
