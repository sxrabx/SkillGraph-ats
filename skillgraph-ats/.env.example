# ==============================================================================
# SkillGraph ATS — Environment Variables Configuration Template
# ==============================================================================
# Add your secret API keys to this file and rename/copy it to '.env'
# NEVER commit the actual '.env' file containing your production keys to GitHub.
# ==============================================================================

# Groq Cloud LPU API Key (Required for structured resume extraction & GraphRAG chat)
# Model: qwen/qwen3.8-27b
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM Cloud API Key (Required for 2048-dimensional cloud GPU embeddings)
# Model: nvidia/nemotron-3-embed-1b
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
