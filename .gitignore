# ==============================================================================
# SkillGraph ATS — Comprehensive Multi-Stack .gitignore
# Frameworks: Python 3.11+, FastAPI, Uvicorn, React 19, Vite 8, Node.js
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Secrets & API Credentials (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Profiling & Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Vite Frontend Build
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build output
dist/
dist-ssr/
*.local

# Vite cache
.vite/

# ------------------------------------------------------------------------------
# 4. Runtime Uploads & Intermediate Pipeline Artifacts
# ------------------------------------------------------------------------------
temp_uploads/
**/temp_uploads/
temp_uploads/*
**/temp_uploads/*
!skillgraph-ats/data/*.pdf
annotated_*.pdf

# ------------------------------------------------------------------------------
# 5. OS & IDE System Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
